<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VTBL.Restrict.Loader</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="corp-header">
        <nav class="navbar navbar-expand-sm mb-3">
            <div class="container layout-bar">
                <a class="navbar-brand" asp-area="" asp-page="/Upload/Index">VTBL.Restrict.Loader</a>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Upload/Index">Загрузка</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="container page-shell">
        <main role="main" class="page-main pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container layout-bar">
            &copy; 2026 — VTBL.Restrict.Loader
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
