@model VTBL.Restrict.Loader.UI.Pages.Upload.IndexModel

@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")"
         role="alert"
         data-upload-result="@(Model.IsSuccess ? "success" : "error")"
         data-error-code="@(Model.ErrorCode ?? "")">
        <strong>@Model.ResultTitle</strong>
        <div>@Model.ResultMessage</div>
        @if (!string.IsNullOrEmpty(Model.CorrelationIdText))
        {
            <div class="mt-1"><small data-correlation-id>correlationId: @Model.CorrelationIdText</small></div>
        }
        @if (Model.ShowRetry)
        {
            <form method="post" asp-page="/Upload/Retry" class="mt-2" data-retry-form="true">
                <input type="hidden" name="correlationId" value="@Model.CorrelationIdText" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" data-retry-button="true">
                    Повторить уведомление
                </button>
            </form>
        }
    </div>
}
