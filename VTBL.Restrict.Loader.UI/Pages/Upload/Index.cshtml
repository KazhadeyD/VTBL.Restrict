@page "/Upload"
@model VTBL.Restrict.Loader.UI.Pages.Upload.IndexModel
@{
    ViewData["Title"] = "Загрузка списка";
}

<h1>Загрузка рестриктивного списка</h1>
<p class="text-muted">Файл передаётся без изменений. Содержимое не просматривается и не разбирается.</p>

<partial name="_UploadResult" model="Model" />

<div asp-validation-summary="ModelOnly" class="text-danger" data-validation-summary="true"></div>

<form method="post" enctype="multipart/form-data" class="mt-3" id="upload-form" data-upload-form="true">
    <div class="form-group">
        <label asp-for="Input.ListTypeCode"></label>
        <select asp-for="Input.ListTypeCode"
                asp-items="Model.ListTypeOptions"
                class="form-control"
                id="Input_ListTypeCode"
                data-list-type-select="true"
                required>
            <option value="">— выберите тип списка —</option>
        </select>
        <span asp-validation-for="Input.ListTypeCode" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.File"></label>
        <div id="upload-dropzone"
             class="corp-dropzone p-4 mb-2 text-center"
             data-upload-dropzone="true">
            <p class="mb-2">Перетащите файл сюда или нажмите «Выбрать файл»</p>
            <button type="button" class="btn btn-sm btn-outline-primary" id="upload-browse" data-upload-browse="true">
                Выбрать файл
            </button>
        </div>
        <input asp-for="Input.File"
               type="file"
               id="upload-file"
               class="form-control-file"
               data-upload-file="true"
               accept=".xlsx,.xls,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv" />
        <span asp-validation-for="Input.File" class="text-danger"></span>
        <div class="upload-file-selected mt-1">
            <div id="upload-file-meta" class="text-muted small" data-upload-file-meta="true"></div>
            <button type="button"
                    class="btn btn-link upload-file-clear"
                    id="upload-file-clear"
                    data-upload-file-clear="true"
                    title="Удалить файл"
                    aria-label="Удалить файл"
                    hidden>&times;</button>
        </div>
    </div>

    <button type="submit" class="btn btn-primary" data-upload-submit="true">Отправить</button>
</form>

<div id="upload-wait"
     class="upload-wait"
     data-upload-wait="true"
     hidden
     aria-live="polite"
     aria-busy="false">
    <div class="upload-wait-panel">
        <div class="upload-wait-spinner" aria-hidden="true"></div>
        <div class="upload-wait-text">Ожидайте</div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/upload-dnd.js" asp-append-version="true"></script>
}
