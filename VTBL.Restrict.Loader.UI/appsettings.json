{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "nlog-internal.log",
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/app-${shortdate}.log",
        "encoding": "utf-8",
        "layout": "${longdate}|${level:uppercase=true}|op=${scopeproperty:operation}|corr=${scopeproperty:correlationId}|list=${scopeproperty:listType}|${logger}|${message}${exception:format=ToString}"
      }
    },
    "rules": [
      { "logger": "Microsoft.*", "minLevel": "Warn", "writeTo": "file" },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RestrictDb": ""
  },
  "RestrictStorage": {
    "RemoteRoot": "",
    "AllowedExtensions": [ ".xlsx", ".xls", ".csv" ],
    "MaxFileSizeBytes": 52428800
  },
  "RabbitMq": {
    "Host": "",
    "VirtualHost": "/",
    "Exchange": "restrict.uploads",
    "Username": "",
    "Password": ""
  }
}
