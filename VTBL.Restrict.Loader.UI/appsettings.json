{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "VTBL.Restrict.Loader": "Information"
    }
  },
  "NLog": {
    "autoReload": true,
    "internalLogLevel": "Info",
    "internalLogFile": "C:\\inetpub\\logs\\VTBL.Restrict.Loader.UI\\internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "variables": {
      "logLayout": "${longdate}|${level:uppercase=true}|${logger}|${message}|${mdlc:item=CorrelationId}|${exception:format=tostring}"
    },
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${var:logLayout}"
      },
      "file": {
        "type": "File",
        "fileName": "C:\\inetpub\\logs\\VTBL.Restrict.Loader.UI\\${shortdate}.log",
        "archiveFileName": "C:\\inetpub\\logs\\VTBL.Restrict.Loader.UI\\archive\\{#}.log",
        "archiveEvery": "Day",
        "archiveNumbering": "Rolling",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 30,
        "layout": "${var:logLayout}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "minLevel": "Warn",
        "writeTo": "console,file",
        "final": true
      },
      {
        "logger": "Microsoft",
        "minLevel": "Warn",
        "writeTo": "console,file",
        "final": true
      },
      {
        "logger": "VTBL.Restrict.Loader*",
        "minLevel": "Debug",
        "writeTo": "console,file",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,file"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RestrictDb": ""
  },
  "RestrictStorage": {
    "AllowedExtensions": [ ".xlsx", ".xls", ".csv" ],
    "MaxFileSizeBytes": 104857600
  },
  "ListTypes": [
    {
      "remoteRoot": "",
      "code": "MVK",
      "name": "МВК"
    },
    {
      "remoteRoot": "",
      "code": "TERRORISTS",
      "name": "Террористы"
    },
    {
      "remoteRoot": "",
      "code": "NFA",
      "name": "Нелегальная финансовая деятельность"
    },
    {
      "remoteRoot": "",
      "code": "OTHER",
      "name": "Прочее"
    }
  ],
  "RabbitMq": {
    "Host": "",
    "VirtualHost": "/",
    "Exchange": "restrict.uploads",
    "Username": "",
    "Password": ""
  }
}
