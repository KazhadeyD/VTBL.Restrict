{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "VTBL.Restrict.Loader": "Information"
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Warn",
    "internalLogFile": "${basedir}/logs/nlog-internal.log",
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/app-${shortdate}.log",
        "archiveFileName": "${basedir}/logs/archive/app-{#}.log",
        "archiveEvery": "Day",
        "archiveNumbering": "Rolling",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 30,
        "keepFileOpen": true,
        "encoding": "utf-8",
        "layout": "${longdate}|${level:uppercase=true}|op=${scopeproperty:operation}|corr=${scopeproperty:correlationId}|list=${scopeproperty:listType}|req=${scopeproperty:requestId}|${logger}|${message}${exception:format=ToString}"
      }
    },
    "rules": [
      { "logger": "Microsoft.*", "minLevel": "Warn", "writeTo": "file" },
      { "logger": "VTBL.Restrict.Loader.*", "minLevel": "Info", "writeTo": "file" },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RestrictDb": ""
  },
  "RestrictStorage": {
    "AllowedExtensions": [ ".xlsx", ".xls", ".csv" ],
    "MaxFileSizeBytes": 52428800
  },
  "ListTypes": [
    {
      "remoteRoot": "",
      "code": "MVK",
      "name": "МВК"
    },
    {
      "remoteRoot": "",
      "code": "TERRORISTS",
      "name": "Террористы"
    },
    {
      "remoteRoot": "",
      "code": "NFA",
      "name": "Нелегальная финансовая деятельность"
    },
    {
      "remoteRoot": "",
      "code": "OTHER",
      "name": "Прочее"
    }
  ],
  "RabbitMq": {
    "Host": "",
    "VirtualHost": "/",
    "Exchange": "restrict.uploads",
    "Username": "",
    "Password": ""
  }
}
