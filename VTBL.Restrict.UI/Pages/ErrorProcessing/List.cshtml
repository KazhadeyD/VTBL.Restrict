@page "/error-processing"
@model VTBL.Restrict.UI.Pages.ErrorProcessing.ListModel
@{
    ViewData["Title"] = "Обработка ошибок";
}

<h1>Обработка ошибок</h1>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert" data-ep-list-error="true">@Model.ListError</div>
}
else if (Model.Items == null || Model.Items.Count == 0)
{
    <div class="alert alert-secondary" role="status" data-ep-list-empty="true">Нет кейсов для обработки</div>
}
else
{
    <table class="table table-sm" data-ep-list="true">
        <thead>
            <tr>
                <th>Кейс</th>
                <th>Тип</th>
                <th>Статус</th>
                <th>Создан</th>
                <th>Срок</th>
                <th>Файл</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr data-ep-case-id="@item.ErrorProcessingCaseId">
                <td>
                    <a asp-page="/ErrorProcessing/Index"
                       asp-route-caseId="@item.ErrorProcessingCaseId"
                       data-ep-case-link="true">
                        @item.ErrorProcessingCaseId
                    </a>
                </td>
                <td data-ep-list-type="true">@item.ListTypeName (@item.ListTypeCode)</td>
                <td data-ep-list-status="true">@item.Status</td>
                <td data-ep-list-created="true">@item.CreatedAtUtc.ToString("u")</td>
                <td data-ep-list-expires="true">@item.ExpiresAtUtc.ToString("u")</td>
                <td data-ep-list-source="true">
                    @if (!string.IsNullOrWhiteSpace(item.SourceFilePath))
                    {
                        <code>@item.SourceFilePath</code>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
